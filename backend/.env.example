# Groq API key for llama-3.3-70b-versatile architecture analysis
GROQ_API_KEY=gsk_your_groq_api_key_here

# GitHub Personal Access Token (PAT) for higher rate limits on GitHub REST API
GITHUB_TOKEN=ghp_your_github_token_here

# Connection URL for Redis key-value store and Celery broker
REDIS_URL=redis://localhost:6379/0

# Comma-separated CORS allowed origins for frontend applications
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum repository size allowed for analysis in Megabytes (default: 200MB)
MAX_REPO_SIZE_MB=200

# Rate limit for analysis endpoint requests per IP per minute
RATE_LIMIT_PER_MINUTE=5

# Optional Sentry DSN for error monitoring and diagnostics
SENTRY_DSN=

# Optional GitHub webhook secret for validating X-Hub-Signature-256 HMAC
GITHUB_WEBHOOK_SECRET=

# LLM provider choice ("groq" or "openai")
LLM_PROVIDER=groq

# Optional OpenAI API Key if using "openai" provider
OPENAI_API_KEY=
